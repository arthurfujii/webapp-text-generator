# Tapitise webapp — variáveis da stack (/srv/apps/tapitise/.env, permissão 600).
# Copie para .env e preencha. Nenhum valor entra no Git.

# --- Build (NEXT_PUBLIC_*, embutidos no bundle pelo next build) ---
# ID do app Dify (console do Dify → Apps → Tapítise)
NEXT_PUBLIC_APP_ID=
# APP API key (app-n...)
NEXT_PUBLIC_APP_KEY=
# Prefixo da API do Dify
NEXT_PUBLIC_API_URL=https://dify.arthurfujii.com.br/v1
# true para apps de workflow (deixe vazio para completion/text generator)
NEXT_PUBLIC_APP_TYPE_WORKFLOW=
# Base URL path (vazio = raiz)
NEXT_PUBLIC_APP_BASE_URL_PATH=
# Prefixo das rotas de proxy da API (default /api)
NEXT_PUBLIC_API_PREFIX=

# --- Runtime (AUTH_*, lidos pelo middleware e pelas rotas de login) ---
# scrypt hash de cada usuário permitido. Gerar com: npm run auth:hash
AUTH_USER_AFUJII_HASH=
AUTH_USER_BCHENQUE_HASH=
# Segredo de assinatura de sessão (>= 32 chars): openssl rand -hex 48
AUTH_SESSION_SECRET=
