# APP ID
NEXT_PUBLIC_APP_ID=
# APP API key
NEXT_PUBLIC_APP_KEY=
# API url prefix
NEXT_PUBLIC_API_URL=
# APP type
# true for workflow apps
NEXT_PUBLIC_APP_TYPE_WORKFLOW=
# Base URL path for the application
NEXT_PUBLIC_APP_BASE_URL_PATH=
# API prefix path for the application
NEXT_PUBLIC_API_PREFIX=
# Authentication (required)
# scrypt password hash for each allowed user.
# Generate with: npm run auth:hash
AUTH_USER_AFUJII_HASH=
AUTH_USER_BCHENQUE_HASH=
# Random session signing secret with at least 32 characters
# e.g. openssl rand -hex 48
AUTH_SESSION_SECRET=
